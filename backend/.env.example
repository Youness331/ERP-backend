APP_NAME="ERP Opérations"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Casablanca

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Origin of the Angular application (also used by CORS).
FRONTEND_URL=http://localhost:4200
# CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Inside Docker Compose these values are overridden by docker-compose.yml.
# For a plain local install, keep SQLite (default) or point to MySQL.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=erp
DB_USERNAME=erp
DB_PASSWORD=secret

# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=erp

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@atlas-operations.ma"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Company identity (printed on ERP documents, MAD currency)
# ---------------------------------------------------------------------------
ERP_COMPANY_NAME="Atlas Operations SARL"
ERP_COMPANY_ADDRESS="12, Boulevard Zerktouni"
ERP_COMPANY_CITY="Casablanca"
ERP_COMPANY_COUNTRY="Maroc"
ERP_COMPANY_PHONE="+212 5 22 00 00 00"
ERP_COMPANY_EMAIL="contact@atlas-operations.ma"
ERP_COMPANY_ICE="001234567000089"
ERP_COMPANY_TAX_ID="12345678"
ERP_COMPANY_RC="RC 123456"
ERP_COMPANY_PATENTE="PAT 654321"

ERP_CURRENCY=MAD
ERP_CURRENCY_SYMBOL=DH
ERP_DEFAULT_TAX_RATE=20
ERP_INVOICE_DUE_DAYS=30
ERP_ALERT_EMAIL="ops@atlas-operations.ma"
